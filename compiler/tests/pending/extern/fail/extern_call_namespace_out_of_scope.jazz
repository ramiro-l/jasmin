/* extern_call_namespace_out_of_scope.jazz: calling a namespaced external function without qualification from outside
 * EXPECTED: fail
 * MESSAGE: typing error: unknown external function: `foo`                    */
namespace A {
  extern fn foo() -> u64;
}

export fn main() -> reg u64 {
  reg u64 r;
  r = @foo();
  return r;
}

/* extern_call_on_non_extern.jazz: using @ prefix on a non-external function
 * EXPECTED: fail 
 * MESSAGE: typing error: unknown external function: `helper`                 */
export fn helper(reg u64 x) -> reg u64 {
  return x;
}

export fn main(reg u64 a) -> reg u64 {
  reg u64 r;
  r = @helper(a);
  return r;
}

/* extern_call_eqop.jazz: using an external call on the right-hand side of +=
 * EXPECTED: fail
 * MESSAGE: typing error: external function calls not allowed at that point */
extern fn add(u64 x, u64 y) -> u64;

export fn main(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 r;
  r = 0;
  r += @add(a, b);
  return r;
}

/* extern_call_namespace_wrong_arg_count.jazz: wrong argument count for namespaced external function
 * EXPECTED: fail
 * MESSAGE: typing error: invalid number of arguments, 2 provided instead of 1*/
namespace A {
  extern fn foo(u64 x) -> u64;
}

export fn main(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 r;
  r = @A::foo(a, b);
  return r;
}

/* extern_call_wrong_return_count.jazz: calling external function with wrong number of return values
 * EXPECTED: fail 
 * MESSAGE: typing error: invalid number of lvalues, 1 provided instead of 2 */
extern fn divmod(u64 x, u64 y) -> u64, u64;

export fn main(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 r;
  r = @divmod(a, b);
  return r;
}
